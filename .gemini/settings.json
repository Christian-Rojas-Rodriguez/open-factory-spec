{
  "$schema": "https://geminicli.com/schemas/settings.json",
  "agents": {
    "overrides": {
      "codebase_investigator": {
        "enabled": false
      }
    }
  },
  "modelConfigs": {
    "overrides": [
      {
        "match": { "overrideScope": "planner" },
        "modelConfig": {
          "generateContentConfig": { "temperature": 0.2 }
        }
      },
      {
        "match": { "overrideScope": "auditor" },
        "modelConfig": {
          "generateContentConfig": { "temperature": 0.1 }
        }
      },
      {
        "match": { "overrideScope": "coder" },
        "modelConfig": {
          "generateContentConfig": { "temperature": 0.3 }
        }
      }
    ]
  }
}
