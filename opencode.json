{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.5",
  "provider": {
    "openai": {
      "options": {
        "timeout": 600000
      }
    }
  },
  "default_agent": "tl",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "instructions": [
    "CLAUDE.md",
    ".claude/specs/constitution.md"
  ]
}
